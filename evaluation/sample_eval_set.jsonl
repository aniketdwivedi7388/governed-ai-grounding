# Sample eval set for governed-ai-grounding.
# Every record is entirely synthetic. Dataset names, figures, owners and policies
# are invented for illustration and correspond to no real organisation.
# Lines beginning with '#' and blank lines are ignored by the loader.
#
# Coverage: 14 cases -- 10 handled correctly, 4 with deliberately injected defects.
#   expected_behaviour: 9 answer, 3 abstain, 2 disambiguate
#   injected defects:   eval-005 answered despite stale context
#                       eval-006 numeric claim absent from context
#                       eval-007 substantively correct but uncited
#                       eval-009 ambiguous term silently resolved
# The defective cases exist to prove the evaluators detect what they claim to.
{"id": "eval-001", "question": "What is Assets under Management and what was the firm-wide figure at the last close?", "expected_answer": "Assets under Management is the certified end-of-day market value of client assets held under a discretionary or advisory mandate, excluding custody-only arrangements. Firm-wide AUM at the 2026-08-09 close was EUR 412.6 billion.", "expected_sources": ["C1"], "retrieved_context": [{"id": "C1", "source": "metric_registry", "dataset": "finance_curated.aum_daily_snapshot", "certified": true, "as_of": "2026-08-09T22:00:00Z", "owner": "Investment Data Stewardship", "sensitivity": "Internal", "content": "Assets under Management (AUM) is the certified end-of-day market value of client assets for which the firm holds a discretionary or advisory mandate. Custody-only arrangements are excluded. Reported in EUR translated at the reference rate for the reporting date. Firm-wide AUM at the 2026-08-09 close was EUR 412.6 billion."}], "generated_answer": "Assets under Management is the certified end-of-day market value of client assets held under a discretionary or advisory mandate; custody-only arrangements are excluded [C1]. At the 2026-08-09 close, firm-wide AUM was EUR 412.6 billion, reported in EUR at the reference rate for that date [C1].", "metadata": {"expected_behaviour": "answer", "as_of_tolerance_days": 2, "evaluated_at": "2026-08-10T09:00:00Z", "domain": "investment_finance", "note": "Baseline good case: certified metric, fresh, cited."}}
{"id": "eval-002", "question": "How is an Active Customer defined for reporting?", "expected_answer": "An Active Customer is a customer party with at least one funded account and at least one financial transaction in the trailing 90 days, measured at month end. Dormant accounts and internal test parties are excluded.", "expected_sources": ["C1"], "retrieved_context": [{"id": "C1", "source": "business_glossary", "dataset": "governance_curated.glossary_terms", "certified": true, "as_of": "2026-07-31T00:00:00Z", "owner": "Customer Data Domain Steward", "sensitivity": "Internal", "content": "Active Customer: a customer party with at least one funded account and at least one financial transaction in the trailing 90 days, measured at month end. Dormant accounts and internal test parties are excluded. Certified definition, reviewed 2026-07-31."}], "generated_answer": "An Active Customer is a customer party with at least one funded account and at least one financial transaction in the trailing 90 days, measured at month end [C1]. Dormant accounts and internal test parties are excluded from the population [C1].", "metadata": {"expected_behaviour": "answer", "as_of_tolerance_days": 45, "evaluated_at": "2026-08-10T09:00:00Z", "domain": "customer", "note": "Definitional lookup: a structured glossary read, not a vector search."}}
{"id": "eval-003", "question": "Who owns the certified client holdings dataset and what is its freshness SLA?", "expected_answer": "The certified dataset finance_curated.client_holdings_daily is owned by the Head of Investment Data Domain with stewardship delegated to the Investment Data Stewardship team. Its freshness SLA is delivery by 06:00 CET each business day, with a completeness target of 99.5%.", "expected_sources": ["C1"], "retrieved_context": [{"id": "C1", "source": "data_catalogue", "dataset": "governance_curated.dataset_registry", "certified": true, "as_of": "2026-08-08T06:00:00Z", "owner": "Data Governance Office", "sensitivity": "Internal", "content": "Dataset finance_curated.client_holdings_daily is certified. Accountable owner: Head of Investment Data Domain. Delegated steward: Investment Data Stewardship team. Quality SLA: completeness at or above 99.5%; freshness by 06:00 CET on each business day. Certification renewed quarterly."}], "generated_answer": "The certified dataset finance_curated.client_holdings_daily is owned by the Head of Investment Data Domain, with day-to-day stewardship delegated to the Investment Data Stewardship team [C1]. Its freshness SLA is delivery by 06:00 CET on each business day, alongside a completeness target of 99.5% [C1].", "metadata": {"expected_behaviour": "answer", "as_of_tolerance_days": 7, "evaluated_at": "2026-08-10T09:00:00Z", "domain": "governance", "note": "Catalogue metadata question; answerable only if the catalogue is in scope for retrieval."}}
{"id": "eval-004", "question": "What will our assets under management be at the end of next quarter?", "expected_answer": "Abstain. No certified forward-looking projection of assets under management exists in the grounded context; approved forecasts are owned by the planning function.", "expected_sources": [], "retrieved_context": [], "generated_answer": "I do not have certified context that supports a forward-looking projection of assets under management. The grounded layer contains historical point-in-time positions only. Approved forecasts are owned by the planning function and should be requested from that team.", "metadata": {"expected_behaviour": "abstain", "evaluated_at": "2026-08-10T09:00:00Z", "domain": "investment_finance", "note": "Required abstention: forward-looking question, no governed source of truth."}}
{"id": "eval-005", "question": "What is the current 30-day delinquency rate on the retail lending book?", "expected_answer": "Abstain. The only available delinquency snapshot is for the month ending 2026-02-28, which is far outside the 45-day currency tolerance for current-state reporting.", "expected_sources": ["C1"], "retrieved_context": [{"id": "C1", "source": "metric_registry", "dataset": "risk_curated.retail_delinquency_monthly", "certified": true, "as_of": "2026-02-28T23:00:00Z", "owner": "Retail Risk Data Stewardship", "sensitivity": "Confidential", "content": "Retail 30-day delinquency rate for the month ending 2026-02-28 was 2.14%. This dataset refreshes monthly. Downstream use for current-state reporting requires a snapshot no older than 45 days."}], "generated_answer": "The 30-day delinquency rate on the retail lending book is 2.14% [C1].", "metadata": {"expected_behaviour": "abstain", "as_of_tolerance_days": 45, "evaluated_at": "2026-08-10T09:00:00Z", "domain": "credit_risk", "note": "FAILURE CASE: stale certified data answered as if current. Certification is not currency."}}
{"id": "eval-006", "question": "How complete is the counterparty reference data used for agent grounding?", "expected_answer": "Counterparty reference data reported 97.8% completeness against a 99.0% threshold on the 2026-08-09 run, so it is currently below threshold and flagged amber.", "expected_sources": ["C1"], "retrieved_context": [{"id": "C1", "source": "data_quality_service", "dataset": "governance_curated.dq_measurement_runs", "certified": true, "as_of": "2026-08-09T04:00:00Z", "owner": "Data Governance Office", "sensitivity": "Internal", "content": "Counterparty reference dataset measurement run 2026-08-09: completeness 97.8%, validity 96.1%. The agreed completeness threshold is 99.0%. The dataset is below threshold and is flagged amber pending remediation."}], "generated_answer": "Counterparty reference data is 97.8% complete against a 99.0% threshold, and enrichment attribute coverage stands at 88.4% [C1].", "metadata": {"expected_behaviour": "answer", "as_of_tolerance_days": 7, "evaluated_at": "2026-08-10T09:00:00Z", "domain": "governance", "note": "FAILURE CASE: 88.4% appears nowhere in the context. Fabricated precision is the highest-severity failure mode."}}
{"id": "eval-007", "question": "What does the business glossary say about Net New Money?", "expected_answer": "Net New Money is client inflows less outflows over a period, excluding market performance and foreign exchange movement, measured at client relationship level and aggregated to the reporting unit.", "expected_sources": ["C1"], "retrieved_context": [{"id": "C1", "source": "business_glossary", "dataset": "governance_curated.glossary_terms", "certified": true, "as_of": "2026-07-20T00:00:00Z", "owner": "Investment Data Stewardship", "sensitivity": "Internal", "content": "Net New Money: the sum of client inflows less client outflows over a period, excluding market performance and foreign exchange movement. Measured at client relationship level and aggregated to the reporting unit. Certified definition."}], "generated_answer": "Net New Money is client inflows less client outflows over a period, excluding market performance and foreign exchange movement. It is measured at client relationship level and aggregated to the reporting unit.", "metadata": {"expected_behaviour": "answer", "as_of_tolerance_days": 60, "evaluated_at": "2026-08-10T09:00:00Z", "domain": "investment_finance", "note": "FAILURE CASE: substantively correct but uncited, so it cannot be defended in review."}}
{"id": "eval-008", "question": "What was revenue last quarter?", "expected_answer": "Revenue maps to two certified definitions: Revenue (Statutory), the IFRS-reported legal entity figure, and Revenue (Management View), the divisional management-basis figure excluding intra-group eliminations and one-off items. Ask the user which is intended before answering.", "expected_sources": ["C1", "C2"], "retrieved_context": [{"id": "C1", "source": "metric_registry", "dataset": "governance_curated.metric_definitions", "certified": true, "as_of": "2026-07-15T00:00:00Z", "owner": "Group Finance", "sensitivity": "Internal", "content": "Revenue (Statutory): IFRS-reported total revenue for the legal entity as published in the financial statements. Certified. Owner: Group Finance."}, {"id": "C2", "source": "metric_registry", "dataset": "governance_curated.metric_definitions", "certified": true, "as_of": "2026-07-15T00:00:00Z", "owner": "Divisional Finance", "sensitivity": "Internal", "content": "Revenue (Management View): internal management-basis revenue allocated to business divisions, excluding intra-group eliminations and one-off items. Certified. Owner: Divisional Finance. Not reconcilable line-for-line to the statutory figure."}], "generated_answer": "The term revenue maps to more than one definition in the certified registry, and they are not interchangeable: Revenue (Statutory) is the IFRS-reported figure for the legal entity [C1], while Revenue (Management View) is the divisional management-basis figure that excludes intra-group eliminations and one-off items [C2]. Could you clarify which definition you need, and for which reporting unit?", "metadata": {"expected_behaviour": "disambiguate", "as_of_tolerance_days": 120, "evaluated_at": "2026-08-10T09:00:00Z", "domain": "finance", "note": "Ambiguous metric handled correctly: surface both definitions, resolve nothing silently."}}
{"id": "eval-009", "question": "Give me the revenue number for the last reported quarter.", "expected_answer": "Revenue maps to two certified definitions with different scopes. Ask which definition and which reporting unit is intended before returning a figure.", "expected_sources": ["C1", "C2"], "retrieved_context": [{"id": "C1", "source": "metric_registry", "dataset": "governance_curated.metric_definitions", "certified": true, "as_of": "2026-07-15T00:00:00Z", "owner": "Group Finance", "sensitivity": "Internal", "content": "Revenue (Statutory): IFRS-reported total revenue for the legal entity as published in the financial statements. Certified. Owner: Group Finance."}, {"id": "C2", "source": "metric_registry", "dataset": "governance_curated.metric_definitions", "certified": true, "as_of": "2026-07-15T00:00:00Z", "owner": "Divisional Finance", "sensitivity": "Internal", "content": "Revenue (Management View): internal management-basis revenue allocated to business divisions, excluding intra-group eliminations and one-off items. Certified. Owner: Divisional Finance. Not reconcilable line-for-line to the statutory figure."}], "generated_answer": "Revenue for the last reported quarter is the IFRS-reported total revenue for the legal entity as published in the financial statements [C1].", "metadata": {"expected_behaviour": "disambiguate", "as_of_tolerance_days": 120, "evaluated_at": "2026-08-10T09:00:00Z", "domain": "finance", "note": "FAILURE CASE: silently picked one of two certified definitions. Two users, two answers, both defensible."}}
{"id": "eval-010", "question": "Where does the client domicile attribute in the certified client master come from, and can an answer using it be traced for audit?", "expected_answer": "client_domicile in reference_curated.client_master is sourced from the onboarding registered-address field, standardised to ISO 3166-1 alpha-2 by the cdi_client_std job, and certified after steward review. Column-level lineage is captured and retained, so answers using it can be traced to source.", "expected_sources": ["C1"], "retrieved_context": [{"id": "C1", "source": "lineage_service", "dataset": "governance_curated.column_lineage", "certified": true, "as_of": "2026-06-30T00:00:00Z", "owner": "Reference Data Stewardship", "sensitivity": "Internal", "content": "Attribute client_domicile in reference_curated.client_master is sourced from the onboarding platform registered-address field, transformed by the standardisation job cdi_client_std which maps to ISO 3166-1 alpha-2 codes, and certified following steward review. Column-level lineage is captured and retained for audit. Last certification review 2026-06-30."}], "generated_answer": "The client_domicile attribute in reference_curated.client_master originates from the registered-address field captured by the onboarding platform, is standardised to ISO 3166-1 alpha-2 codes by the cdi_client_std job, and is certified following steward review [C1]. Column-level lineage is captured and retained, so an answer that uses this attribute can be traced back to source for audit [C1].", "metadata": {"expected_behaviour": "answer", "as_of_tolerance_days": 120, "evaluated_at": "2026-08-10T09:00:00Z", "domain": "governance", "note": "Provenance question: the answer to 'how do you know that' must itself be groundable."}}
{"id": "eval-011", "question": "What quality thresholds must a dataset meet before it can ground a customer-facing agent?", "expected_answer": "It must be certified, have a named accountable owner, meet completeness of at least 99.0% and validity of at least 98.0% on the latest measurement run, and carry a documented freshness SLA. Amber or red datasets are excluded from customer-facing grounding.", "expected_sources": ["C1"], "retrieved_context": [{"id": "C1", "source": "policy_library", "dataset": "governance_curated.policy_documents", "certified": true, "as_of": "2026-05-01T00:00:00Z", "owner": "Data Governance Office", "sensitivity": "Internal", "content": "A dataset may ground a customer-facing agent only where it is certified, has a named accountable owner, meets a completeness threshold of 99.0% and a validity threshold of 98.0% on the latest measurement run, and carries a documented freshness SLA. Datasets in amber or red quality status are excluded from customer-facing grounding and may support internal exploratory agents only."}], "generated_answer": "A dataset must be certified, have a named accountable owner, meet completeness of at least 99.0% and validity of at least 98.0% on the latest measurement run, and carry a documented freshness SLA [C1]. Datasets in amber or red quality status are excluded from customer-facing grounding and may support internal exploratory agents only [C1].", "metadata": {"expected_behaviour": "answer", "as_of_tolerance_days": 365, "evaluated_at": "2026-08-10T09:00:00Z", "domain": "governance", "note": "Policy lookup. Long tolerance: policy text ages slowly, position data does not."}}
{"id": "eval-012", "question": "What is today's intraday cash position for the treasury book?", "expected_answer": "Abstain. Only an end-of-day snapshot for 2026-08-07 is available in the governed layer; intraday positions are not published there and must come from the treasury system of record.", "expected_sources": ["C1"], "retrieved_context": [{"id": "C1", "source": "metric_registry", "dataset": "treasury_curated.cash_position_snapshot", "certified": true, "as_of": "2026-08-07T17:00:00Z", "owner": "Treasury Data Stewardship", "sensitivity": "Confidential", "content": "Treasury cash position snapshot for the 2026-08-07 close: EUR 1.84 billion. This dataset is an end-of-day snapshot. Intraday positions are not published to the governed data layer."}], "generated_answer": "I cannot answer this from the governed context. The only certified snapshot available is the end-of-day position for 2026-08-07, and intraday positions are not published to the governed data layer. An intraday figure would need to come from the treasury system of record under its own controls.", "metadata": {"expected_behaviour": "abstain", "as_of_tolerance_days": 1, "evaluated_at": "2026-08-10T09:00:00Z", "domain": "treasury", "note": "Required abstention honoured: the grain of the question does not match the grain of the data."}}
{"id": "eval-013", "question": "Can I use the marketing engagement extract to ground an agent that answers client questions?", "expected_answer": "No. The marketing engagement extract is uncertified, with no accountable owner, no quality SLA and no documented lineage, and policy excludes exploratory datasets from customer-facing grounding.", "expected_sources": ["C1"], "retrieved_context": [{"id": "C1", "source": "data_catalogue", "dataset": "governance_curated.dataset_registry", "certified": false, "as_of": "2026-06-15T00:00:00Z", "owner": null, "sensitivity": "Internal", "content": "Dataset marketing_sandbox.engagement_extract is uncertified. It has no named accountable owner, no quality SLA and no documented lineage. It is classified as exploratory and is excluded from customer-facing grounding by policy."}], "generated_answer": "No. The marketing engagement extract is uncertified, with no named accountable owner, no quality SLA and no documented lineage, and policy excludes exploratory datasets from customer-facing grounding [C1]. To become eligible it would need certification, an accountable owner, a quality SLA and captured lineage.", "metadata": {"expected_behaviour": "answer", "as_of_tolerance_days": 180, "evaluated_at": "2026-08-10T09:00:00Z", "domain": "governance", "note": "The catalogue entry for an uncertified dataset is itself governed context worth retrieving."}}
{"id": "eval-014", "question": "Does the agent apply my own access permissions when it retrieves data?", "expected_answer": "Yes. Retrieval executes under the requesting user's entitlements: identity is resolved against the governed access model before candidate context is fetched, context the caller is not entitled to see is never assembled into the prompt, and the identity, datasets touched and filter applied are logged.", "expected_sources": ["C1"], "retrieved_context": [{"id": "C1", "source": "architecture_standard", "dataset": "governance_curated.policy_documents", "certified": true, "as_of": "2026-04-01T00:00:00Z", "owner": "Data Governance Office", "sensitivity": "Internal", "content": "Retrieval executes under the entitlements of the requesting user. The retrieval service resolves the caller identity against the governed access model before any candidate context is fetched, and records the identity, the datasets touched and the filter applied in the audit log. Context the caller is not entitled to see is never assembled into the prompt."}], "generated_answer": "Yes. Retrieval executes under your own entitlements: the retrieval service resolves your identity against the governed access model before any candidate context is fetched, so context you are not entitled to see is never assembled into the prompt [C1]. The identity, the datasets touched and the filter applied are recorded in the audit log [C1].", "metadata": {"expected_behaviour": "answer", "as_of_tolerance_days": 365, "evaluated_at": "2026-08-10T09:00:00Z", "domain": "security", "note": "Entitlement propagation stated as a pre-retrieval filter, not a post-generation redaction."}}
